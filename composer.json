{
    "name": "mgwa/whatsapp-client",
    "description": "حزمة PHP / Laravel متكاملة للربط ببوابة واتساب MGWA لإرسال واستقبال الرسائل وإدارة الجلسات والـ Webhooks",
    "type": "library",
    "keywords": [
        "whatsapp",
        "mgwa",
        "laravel",
        "sdk",
        "gateway",
        "api",
        "messaging"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "MGWA Gateway Team"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Mgwa\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mgwa\\Client\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mgwa\\Client\\Laravel\\MgwaServiceProvider"
            ],
            "aliases": {
                "Mgwa": "Mgwa\\Client\\Laravel\\Facades\\Mgwa"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
